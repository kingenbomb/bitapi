# bit-api 环境变量样板。抄成 .env 再填;.env 已在 .gitignore 里,永远不进仓。
# 三个密钥不改、又监听非回环地址,进程会拒绝启动。

# ---- 必改 ----
BITAPI_JWT_SECRET=换成 32 位以上随机串
BITAPI_API_KEY=sk-换成内部主密钥
BITAPI_ADMIN_KEY=adm-换成号池管理密钥
# 对外可访问的站点根地址(支付回调、找回密码链接都用它;管理台可覆盖)
BITAPI_SITE_URL=https://your-domain.com

# ---- 监听(Docker 里保持 0.0.0.0,端口由 compose 映射到 127.0.0.1) ----
BITAPI_HOST=0.0.0.0
BITAPI_PORT=8080

# ---- 注册与默认分组 ----
BITAPI_REQUIRE_INVITE=1
BITAPI_DEFAULT_GROUP=free
BITAPI_SIGNUP_BONUS=0

# ---- 插件与告警 ----
BITAPI_PLUGINS=affiliate_percent,alert_webhook
# Telegram:https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>
# Bark:    https://api.day.app/<key>
BITAPI_ALERT_WEBHOOK_URL=

# ---- 邮件(注册验证码 / 找回密码 / 邮箱验证;管理台「邮件设置」可覆盖) ----
# 首个管理员也需要邮件验证码，首次启动前配置 SMTP。
# 以下为虚构示例，按发信服务商替换，不是可直接使用的账号：
# BITAPI_SMTP_HOST=smtp.example.com
# BITAPI_SMTP_PORT=587
# BITAPI_SMTP_SECURITY=starttls
# BITAPI_SMTP_USER=no-reply@example.com
# BITAPI_SMTP_PASS=填写服务商提供的SMTP授权码
# BITAPI_SMTP_FROM=no-reply@example.com
BITAPI_SMTP_HOST=
BITAPI_SMTP_PORT=465
BITAPI_SMTP_SECURITY=ssl
BITAPI_SMTP_USER=
BITAPI_SMTP_PASS=
BITAPI_SMTP_FROM=
BITAPI_SITE_NAME=bit-api

# 注册验证码：15 分钟有效，60 秒后可重发，最多校验错误 5 次。
# 每小时发信上限；0 表示不限，生产建议保留默认限制。
# BITAPI_AUTH_REGISTER_MAIL_PER_IP=10
# BITAPI_AUTH_REGISTER_MAIL_PER_EMAIL=3
# 邀请奖励默认关闭，在管理控制台「站点设置 → 注册邀请奖励」配置。
# 示例：每人 $0.25、每位邀请人最多奖励 10 人；以实际保存值为准。

# ---- 社区账号登录(Flarum community-connect;三项留空 = 关闭) ----
BITAPI_COMMUNITY_BASE_URL=
BITAPI_COMMUNITY_CLIENT_ID=
BITAPI_COMMUNITY_CLIENT_SECRET=
BITAPI_COMMUNITY_REDIRECT_URI=

# ---- 输出洗词(反代出去时抹掉上游品牌名;默认词表为空,要抹谁自己列) ----
# BITAPI_SCRUB=1
# BITAPI_SCRUB_TERMS=上游品牌名1,上游品牌名2

# ---- 支付(易支付;管理台「支付设置」可覆盖。留空 = 不开充值) ----
BITAPI_PAYMENT_PROVIDERS=
BITAPI_EPAY_URL=
BITAPI_EPAY_PID=
BITAPI_EPAY_KEY=
BITAPI_EPAY_USD_RATE=7.2

# ---- 备份 ----
BITAPI_BACKUP_INTERVAL=86400
BITAPI_BACKUP_KEEP=7

# ---- 渠道路由默认值(管理台可覆盖):{"渠道名": {"priority": 0, "weight": 1}} ----
# BITAPI_CHANNEL_ROUTING=

# ---- 渠道:ChatGPT 订阅号(Codex 那条 Responses 端点) ----
# 号从管理台「导入账号」进池(或 POST /admin/accounts/import),
# 凭据是 {"refresh_token": ..., "id_token"/"email"/"chatgpt_account_id": ...}。
# 只列订阅额度认得的模型;挂了没额度的模型,用户每次调都必然失败,
# 而失败会被记成账号级问题。
# BITAPI_OPENAI_MODELS=gpt-5.4,gpt-5.4-mini,gpt-5.3-codex
# BITAPI_OPENAI_BASE_URL=https://chatgpt.com/backend-api/codex
# BITAPI_OPENAI_TOKEN_ENDPOINT=https://auth.openai.com/oauth/token
# Codex CLI 的公开 client id —— 订阅号的 refresh 流程只认它,换成自己的会 400
# BITAPI_OPENAI_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# access_token 很短命,提前多少秒刷。巡检半小时一轮,提前量小于它等于白等一轮
# BITAPI_OPENAI_REFRESH_MARGIN=1800
# 上游按 User-Agent / version 头认 CLI 版本,太旧会被拒
# BITAPI_OPENAI_CLI_VERSION=0.125.0
# BITAPI_OPENAI_TIMEOUT=300

# ---- 渠道:Anthropic 订阅号(Messages 端点) ----
# 凭据是 {"refresh_token": ..., "account_uuid": ...}。订阅号只认 Claude Code
# 这个客户端(身份块 + anthropic-beta 头),版本号随上游轮换,过期表现为 403。
# BITAPI_CLAUDE_MODELS=claude-opus-4-8,claude-sonnet-5,claude-sonnet-4-6,claude-haiku-4-5
# BITAPI_CLAUDE_BASE_URL=https://api.anthropic.com
# BITAPI_CLAUDE_TOKEN_ENDPOINT=https://platform.claude.com/v1/oauth/token
# Claude Code 的公开 PKCE client id(公共客户端,没有 client secret)
# BITAPI_CLAUDE_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
# BITAPI_CLAUDE_REFRESH_MARGIN=1800
# BITAPI_CLAUDE_CLI_VERSION=2.1.161
# BITAPI_CLAUDE_TIMEOUT=300
