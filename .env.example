# bit-api 环境变量样板。抄成 .env 再填;.env 已在 .gitignore 里,永远不进仓。
# 三个密钥不改、又监听非回环地址,进程会拒绝启动。

# ---- 必改 ----
BITAPI_JWT_SECRET=换成 32 位以上随机串
BITAPI_API_KEY=sk-换成内部主密钥
BITAPI_ADMIN_KEY=adm-换成号池管理密钥
# 对外可访问的站点根地址(支付回调、找回密码链接都用它;管理台可覆盖)
BITAPI_SITE_URL=https://your-domain.com
# 允许留着上面三个默认密钥跑起来(仅本机联调用;监听非回环地址时必须为 0,否则拒绝启动)
# BITAPI_ALLOW_DEFAULT_SECRETS=0

# ---- 监听(Docker 里保持 0.0.0.0,端口由 compose 映射到 127.0.0.1) ----
BITAPI_HOST=0.0.0.0
BITAPI_PORT=8080
# 默认 0。仅当源站只允许可信反代访问，并由反代覆盖 X-Forwarded-For 时显式开 1
# BITAPI_TRUST_PROXY_HEADERS=1
# 请求体默认上限 12 MiB，音频转录为 26 MiB；分块上传同样受限
# BITAPI_MAX_REQUEST_BYTES=12582912
# BITAPI_MAX_AUDIO_BYTES=27262976
# BITAPI_GEN_MAX_N=4

# ---- 库与会话 ----
# 默认库名 bitapi.db;旧部署沿用 poolgate.db(不存在 bitapi.db 时自动回退)
# BITAPI_DB=
# 会话有效期(秒),默认 7 天
# BITAPI_JWT_TTL=604800
# key→user/group 鉴权缓存秒数,默认 10
# BITAPI_AUTH_CACHE_TTL=10

# ---- 登录/注册/找回密码 限流(按 IP 与按邮箱分别计数) ----
# BITAPI_AUTH_LOGIN_FAILS_PER_IP=20
# BITAPI_AUTH_LOGIN_FAILS_PER_EMAIL=8
# BITAPI_AUTH_LOGIN_WINDOW=600
# BITAPI_AUTH_REGISTER_PER_IP=5
# BITAPI_AUTH_REGISTER_WINDOW=3600
# BITAPI_AUTH_RESET_PER_EMAIL=3
# BITAPI_AUTH_RESET_PER_IP=10
# BITAPI_AUTH_RESET_WINDOW=3600
# BITAPI_AUTH_REGISTER_MAIL_PER_IP=10
# BITAPI_AUTH_REGISTER_MAIL_PER_EMAIL=3
# 找回密码链接有效期(秒),默认 30 分钟
# BITAPI_PASSWORD_RESET_TTL=1800

# ---- 号池巡检与超时 ----
# 上游请求超时(秒),默认 120
# BITAPI_TIMEOUT=120
# 首 token 超时(秒)
# BITAPI_FIRST_TOKEN_TIMEOUT=
# 流式总时长上限(秒)
# BITAPI_STREAM_TOTAL_TIMEOUT=
# token 过期前提前刷新(秒),默认 600
# BITAPI_REFRESH_MARGIN=600
# 巡检间隔(秒)与并发,默认 1800 / 50
# BITAPI_SCAN_INTERVAL=1800
# BITAPI_SCAN_CONCURRENCY=50
# 模型状态巡检间隔(秒)与"慢"阈值(毫秒)
# BITAPI_MODEL_STATUS_INTERVAL=
# BITAPI_MODEL_STATUS_SLOW_MS=10000
# 号池余额低于此值不再取号
# BITAPI_MIN_BALANCE=0.05
# 每日签到奖励区间
# BITAPI_CHECKIN_MIN=0.01
# BITAPI_CHECKIN_MAX=0.10
# 显式停用的渠道(逗号分隔,如 magicpatterns 之类退役渠道不必写)
# BITAPI_DISABLED_CHANNELS=

# 流式调用持续有模型输出就继续；连续无有效输出的超时秒数，心跳不续期。
# BITAPI_STREAM_IDLE_TIMEOUT=120
# GPT OAuth 单独使用 sub2 风格策略：持续输出不设总时长上限；心跳不续期。
# 首输出/高推理/响应头为 0 表示不另设短时限；响应头仍受 180 秒空闲上限约束。
# BITAPI_GPT_FIRST_OUTPUT_TIMEOUT=0
# BITAPI_GPT_HIGH_EFFORT_FIRST_OUTPUT_TIMEOUT=0
# BITAPI_GPT_RESPONSE_HEADER_TIMEOUT=0
# BITAPI_GPT_STREAM_IDLE_TIMEOUT=180
# 过载仅在输出前同号重试 3 次（共 4 次），有输出后不重放。
# BITAPI_GPT_CAPACITY_RETRIES=3
# GPT 普通故障最多切换 10 次；首输出超时最多切换 1 次，429 最多尝试 3 个账号。
# BITAPI_GPT_MAX_ACCOUNT_SWITCHES=10
# 并发以账号编辑页的值为准，0 为不限；排队默认最多 30 秒、每号最多 100 人。
# BITAPI_GPT_ACCOUNT_WAIT_TIMEOUT=30
# BITAPI_GPT_ACCOUNT_MAX_WAITING=100
# 超时默认不影响账号调度；开启后 10 分钟内 3 次超时暂缓 5 分钟。
# BITAPI_GPT_TIMEOUT_PENALTY_ENABLED=0
# BITAPI_GPT_TIMEOUT_THRESHOLD=3
# BITAPI_GPT_TIMEOUT_WINDOW=600
# BITAPI_GPT_TIMEOUT_PAUSE=300

# ---- 注册与默认分组 ----
# 总开关：1 = 任何入口都不再建号（邮箱注册、发验证码、社区授权注册全部拒绝）。
# 已有账号登录、绑定社区、找回密码不受影响。后台「站点设置 → 注册与分组」可覆盖，
# 保存立即生效，无需重启。默认 0（正常开放注册）。
BITAPI_REGISTRATION_CLOSED=0
# 生产站启用：新用户仅允许白嫖社区授权注册；邮箱/邀请码不能绕过等级门槛。
BITAPI_COMMUNITY_REGISTRATION_ONLY=1
# 社区最低注册等级 0~6，默认 Lv3；后台「站点设置 → 注册与分组」可覆盖，保存立即生效。
BITAPI_COMMUNITY_MIN_LEVEL=3
# 仅在未启用社区专用注册时控制邮箱注册；不影响社区等级门槛。
BITAPI_REQUIRE_INVITE=1
BITAPI_DEFAULT_GROUP=free
BITAPI_SIGNUP_BONUS=0

# ---- 插件与告警 ----
BITAPI_PLUGINS=affiliate_percent,alert_webhook
# Telegram:https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>
# Bark:    https://api.day.app/<key>
BITAPI_ALERT_WEBHOOK_URL=

# ---- 邮件(找回密码 / 邮箱验证;管理台「邮件设置」可覆盖) ----
BITAPI_SMTP_HOST=
BITAPI_SMTP_PORT=465
BITAPI_SMTP_SECURITY=ssl
BITAPI_SMTP_USER=
BITAPI_SMTP_PASS=
BITAPI_SMTP_FROM=
# 发件人显示名(留空则只用邮箱地址)
BITAPI_SMTP_FROM_NAME=
BITAPI_SITE_NAME=bit-api

# ---- 白嫖社区 OAuth（服务端配置，重启生效；与支付商户凭据独立） ----
# 在 https://baipiao.org/bbs/connect/apps 登记应用及下方完整回调地址。
BITAPI_COMMUNITY_BASE_URL=https://baipiao.org/bbs
BITAPI_COMMUNITY_CLIENT_ID=
BITAPI_COMMUNITY_CLIENT_SECRET=
BITAPI_COMMUNITY_REDIRECT_URI=https://ai.baipiao.co/oauth/baipiao-community

# ---- 支付(管理台「支付设置」可覆盖。留空 = 不开充值；可填 epay,baipiao) ----
BITAPI_PAYMENT_PROVIDERS=
BITAPI_EPAY_URL=
BITAPI_EPAY_PID=
BITAPI_EPAY_KEY=
BITAPI_EPAY_USD_RATE=7.2
BITAPI_BAIPIAO_PID=
BITAPI_BAIPIAO_KEY=
# 每 $1 API 余额所需毛数，默认 1 毛换 $1；小数毛向上取整。
# 社区侧商户扣毛比例必须设为 1:1，本站比例只在此处调整。
BITAPI_MAO_PER_USD=1

# ---- 备份 ----
BITAPI_BACKUP_INTERVAL=86400
BITAPI_BACKUP_KEEP=7
# 备份目录,留空 = 与库文件同级的 backups/
# BITAPI_BACKUP_DIR=

# ---- 渠道路由默认值(管理台可覆盖):{"渠道名": {"priority": 0, "weight": 1}} ----
# BITAPI_CHANNEL_ROUTING=

# ---- 各渠道模型清单覆盖(留空 = 用 adapter 内置目录) ----
# BITAPI_GPT_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
# BITAPI_PRICING_URL=
# BITAPI_PRICING_PATH=
# BITAPI_PRICING_REFRESH=86400
# BITAPI_PRICING_CACHE_TTL=30

# ---- 计费与订单 ----
# 单人单笔充值下限(美元)
# BITAPI_MIN_TOPUP=1.0
# 订单未支付自动关闭(秒),默认 30 分钟
# BITAPI_ORDER_TTL=1800

# ---- 生成媒体(图/视频自托管) ----
# 媒体缓存目录,留空 = 库文件同级的 media/;保留时长(秒)
# BITAPI_MEDIA_DIR=
# BITAPI_MEDIA_TTL=1800

# ---- 出站脱敏(把上游名字/密钥痕迹从响应里抹掉) ----
# BITAPI_SCRUB=1
# 额外要脱敏的词(逗号分隔)
# BITAPI_SCRUB_TERMS=

# ---- Anthropic 兼容层 ----
# 是否把上游的 reasoning 透出成 thinking 块
# BITAPI_ANTHROPIC_EXPOSE_REASONING=1

# ---- /mcp 端点(MCP 服务,从 key 池取号) ----
# 是否开放匿名访问;每分钟每 IP 上限
# BITAPI_MCP_OPEN=0
# BITAPI_MCP_RPM=
# 上游基址与取号用的 key 文件通配(data/tf_*.txt)
# BITAPI_MCP_UPSTREAM=
# BITAPI_MCP_KEY_GLOB=data/tf_*.txt

# ---- 虚拟工具桥(把纯文本上游伪装成支持 OpenAI tool_calls) ----
# 允许走桥的渠道名(逗号分隔)。正常靠 adapter.virtual_tools 声明,这里是改名兜底。
# BITAPI_VIRTUAL_TOOL_CHANNELS=
# 调试:打印虚拟工具桥的中间态
# BITAPI_DEBUG_VTOOLS=0

# ---- 一次性注册脚本专用(scripts/register_*.py,服务本身不读) ----
# BITAPI_TM_BASE=
# BITAPI_TM_KEY=
# BITAPI_TF_REF=
# BITAPI_OR_PASSWORD=
# BITAPI_BASE_URL=
# BITAPI_CHANNEL=
# BITAPI_ADMIN_EMAIL=
# BITAPI_ADMIN_PASSWORD=
# 白嫖社区 HTTP 超时(秒)
# BITAPI_COMMUNITY_HTTP_TIMEOUT=

# ---- GPT/Codex 原生 OAuth 号池（无需额外转发服务，修改后重启生效） ----
# 凭据在现有账号数据库；本站直接请求 Codex Responses 并自动续期。
# BITAPI_GPT_BASE_URL=https://chatgpt.com/backend-api/codex
# BITAPI_GPT_TOKEN_URL=https://auth.openai.com/oauth/token
# BITAPI_GPT_CLIENT_VERSION=0.166.0
# BITAPI_GPT_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
# Web 生图对外模型为 gpt-image-2-web，复用 GPT OAuth 账号和账号代理。
# BITAPI_GPT_WEB_IMAGE_UPSTREAM_MODEL=gpt-5-5

# ---- 共享 Key(用户上传上游 key 换余额奖励。管理台「邀请与奖励」可覆盖) ----
# 默认关闭。开启后,用户提交的 key 会先真发一次请求验活,通过才入库当号用并按把发奖。
BITAPI_SHARE_REWARD_ENABLED=0
BITAPI_SHARE_REWARD_AMOUNT=2
# 允许共享的渠道(逗号分隔)。留空 = 所有 key 池型对话渠道都收。
BITAPI_SHARE_REWARD_CHANNELS=
# 每人可拿奖励的 key 把数上限,0 = 不限。
BITAPI_SHARE_REWARD_MAX_PER_USER=0
